# Demo video recordings — keep local only
*.mp4

# Environment variables - never commit these
.env

# Local TLS key material (scripts/tls/generate-dev-tls.sh)
certs/
.venv-barcode/

# Local dev auth session persistence (DEV_PERSIST_AUTH_SESSIONS via dev-up.sh)
.dev-auth-sessions.json

# Node dependencies - reinstalled via npm install
node_modules/

# Mac junk files
.DS_Store

# Python bytecode
__pycache__/
*.py[cod]

# Logs
*.log
npm-debug.log*

# OCI wallet files (if you ever add wallet-based auth)
wallet/
*.p12
*.sso

# Generated OCI inventory for admin Platform tab (scripts/oci/sync-systems-manifest.sh)
data/systems-oci-resources.json

# iOS build artifacts (archives and exported IPAs)
build/archives/
build/export/

# Terraform - secrets and generated state
terraform/terraform.tfvars
terraform/terraform.dev.tfvars
terraform/container_env.auto.tfvars
terraform/container_env.prod.tfvars
terraform/container_env.dev.tfvars
terraform/lb_tls.auto.tfvars
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfstate.*.backup
terraform/terraform.dev.tfstate
terraform/terraform.dev.tfstate.backup
terraform/terraform.dev.tfstate.*.backup

# AWS Terraform (parallel stack — see terraform-aws/)
terraform-aws/terraform.tfvars
terraform-aws/.terraform/
terraform-aws/tfplan
terraform-aws/terraform.tfstate
terraform-aws/terraform.tfstate.backup
terraform-aws/terraform.tfstate.*.backup

# Dev OCI env (local ORDS pointer — optional)
.env.dev

# IdP dev bootstrap state (domain OCIDs — no passwords)
scripts/oci/idp/state/

# Stray Terraform state outside terraform/ (never commit)
scripts/*.tfstate
scripts/*.tfstate.*

# Android POS — Gradle, Studio, and all build outputs (rebuild with ./gradlew)
android-pos/.gradle/
android-pos/**/build/
android-pos/local.properties
android-pos/.idea/
android-pos/*.iml
android-pos/captures/
android-pos/.externalNativeBuild/
android-pos/.cxx/

# Android Lister — Gradle, Studio, and build outputs
android-lister/.gradle/
android-lister/**/build/
android-lister/local.properties
android-lister/.idea/
android-lister/*.iml
android-lister/captures/
android-lister/.externalNativeBuild/
android-lister/.cxx/

# iOS admin — Xcode local overrides and user state
ios-admin/Config/Local.xcconfig
ios-admin/**/xcuserdata/
ios-admin/**/DerivedData/
ios-pos/Config/Local.xcconfig
ios-pos/**/xcuserdata/
ios-pos/**/DerivedData/
ios-lister/Config/Local.xcconfig
ios-lister/**/xcuserdata/
ios-lister/**/DerivedData/

.venv-certbot/
